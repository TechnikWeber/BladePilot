# Build output
/target/
**/node_modules/
/apps/desktop/ui/dist/

# Private reverse-engineering workspace: extracted vendor software, analysis
# projects, notes and USB captures of vendor software. Never commit it.
/re/

# USB captures stay private unless they are our own test fixtures
*.pcap
*.pcapng
!/crates/*/tests/fixtures/*.pcapng

# Simulator previews and dry-run output
/out/
*.preview.svg

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Tauri writes its permission schemas here on every build
/apps/desktop/src-tauri/gen/
